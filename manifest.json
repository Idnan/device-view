{
  "manifest_version": 3,
  "name": "Device View",
  "version": "2.0.0",
  "description": "View the current tab as a phone, tablet or custom size without opening DevTools.",
  "permissions": ["debugger", "tabs", "declarativeNetRequest", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Device View" }
}

{
  "manifest_version": 3,
  "name": "Device View",
  "version": "1.0.0",
  "description": "View the current tab as a phone, tablet or custom size without opening DevTools.",
  "permissions": ["tabs", "declarativeNetRequest", "scripting", "storage", "offscreen"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_popup": "popup.html", "default_title": "Device View",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  }
}
